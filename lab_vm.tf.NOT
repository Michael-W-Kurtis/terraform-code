data "aws_ami" "ubuntu" {
  most_recent = true
  filter {
    name   = "name"
    values = ["ubuntu/images/hvm-ssd/ubuntu-jammy-22.04-amd64-server-*"]
  }
  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }
  owners = ["099720109477"] # Canonical
}

# --- NEW: Define a Security Group to allow SSH traffic ---
resource "aws_security_group" "lab_sg" {
  name        = "homelab-terraform-sg"
  description = "Allow inbound SSH traffic"

  ingress {
    description = "SSH from anywhere (update with your IP for security)"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"] 
  }

  egress {
    description = "Allow all outbound traffic"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "Lab-Security-Group-1"
  }
}

resource "aws_instance" "lab_vm" {
  ami           = data.aws_ami.ubuntu.id
  instance_type = "t2.micro"

  # --- NEW: Attach the security group to the instance ---
  vpc_security_group_ids = [aws_security_group.lab_sg.id]

  tags = {
    Name = "HomeLab-Terraform-Test"
  }
}

output "instance_ip" {
  value       = aws_instance.lab_vm.public_ip
  description = "Public IP address of the t2.micro test instance"
}
